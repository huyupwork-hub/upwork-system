# FieldProof — environment configuration
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Values come from: Supabase Dashboard -> Project Settings -> API

# ---- Safe for client bundles (Flutter + browser) ----
# The anon key is designed to be public. It is safe ONLY because RLS is enabled
# and forced on every table; see docs/DATA_MODEL.md section 5.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Next.js admin reads the same two values under its public prefix.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

USER_A=
PASS_USER_A=
USER_B=
PASS_USER_B=
ADMIN=
PASS_ADMIN=

# ---- NEVER ships to a client. NEVER committed. ----
# Local use and GitHub Actions secrets only. This key bypasses RLS entirely.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---- GitHub Actions secrets required for CI ----
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
