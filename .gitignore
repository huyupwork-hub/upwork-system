# Secrets — never commit. See .env.example for the documented shape.
.env
.env.*
!.env.example

# macOS
.DS_Store

# Node / Next.js
node_modules/
.next/
out/
coverage/
*.tsbuildinfo

# Flutter / Dart
.dart_tool/
.packages
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties

# Supabase local stack
supabase/.branches/
supabase/.temp/

# Flutter platform scaffolding — generated in CI (docs/DECISIONS.md D12)
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.flutter-plugins*
apps/mobile/coverage/

# Xcode.app was extracted into this directory by accident (12 GB). Ignored so it
# can never be staged; it should be moved out of the repo entirely.
/Xcode.app/

# Self-hosted GitHub Actions runner. On the service box it lives inside this
# directory. Never commit it: ~3.7 GB of toolcache, and .credentials holds the
# runner's auth token.
/actions-runner/

# Vercel CLI link metadata — machine-local, never committed.
.vercel/

# Flutter dependency lock. This repository has never held one: CI resolves from
# pubspec.yaml on every run, and the version that matters is the one the CI
# Flutter picks. A lock file committed by accident is worse than none — one got
# in here written by a standalone Dart 3.6.2 running `dart run` from the repo
# root, pinning pdf 3.12.0 against a toolchain that resolves 3.13.0, and CI
# honoured it and failed to analyze code that had not changed.
#
# If a lock is ever wanted deliberately, delete this rule and generate it with
# the same Flutter version CI uses — do not let a stray `dart run` write it.
apps/mobile/pubspec.lock
