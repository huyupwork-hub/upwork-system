# Public, browser-safe Supabase configuration. Both values are published to the
# client bundle by design; neither confers privilege beyond RLS.
#
# The service-role key must NEVER appear here or anywhere in this app. CI greps
# the built bundle for it and fails the build if it is present.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
